<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- lets a normal app request an uninstall through PackageInstaller, still shows the system
         confirmation dialog - section 17, 18 of the spec (clean install) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- the curated catalog is fetched remotely, so package names to check aren't known at build
         time - a static <queries> allowlist can't cover that; this is the same justification
         F-Droid/Aurora Store use, section 13 of the spec -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- requested during first-run onboarding on Android 13+, amendment 44.4 of the spec -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ManagerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Manager"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">

        <!-- INFO lets App info's Open button and installers start Krate while its icon is hidden -->
        <activity
            android:name=".KrateActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="uiMode"
            android:theme="@style/Theme.Manager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- the launcher icon, off here so hiding leaves no stand-in icon; Krate turns it on (see LauncherIcon) -->
        <activity-alias
            android:name=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".KrateActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".platform.LauncherIconReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- receives the PackageInstaller session result, section 15 + 42.17 -->
        <receiver
            android:name=".platform.packageinstaller.InstallResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".platform.selfupdate.ManagerUpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
