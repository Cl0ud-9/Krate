<?xml version="1.0" encoding="utf-8"?>
<!-- nothing goes to cloud backup; moving to a new phone leaves behind the token, which needs this phone's key, and big downloads -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="github_credentials.xml" />
        <exclude domain="file" path="private-manifest-cache.json" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="rollback/" />
    </device-transfer>
</data-extraction-rules>
